---
layout: default
title: "Reflections & Refactors"
paginate:
  collection: posts
  per_page: 4
  permalink: /posts/page/:num/
---

<p class="site-tagline"><%= site.metadata.description %></p>

<ul class="article-list">
  <% paginator.resources.each do |post| %>
    <li class="article-list-item">
      <a href="<%= post.relative_url %>"><h2><%= post.data.title %></h2></a>
      <p class="article-list-description"><%= post.data.description %></p>
      <%= render ArticleMeta.new(post:) %>
    </li>
  <% end %>
</ul>

<% if paginator.total_pages > 1 %>
  <nav class="article-pagination" aria-label="Pagination">
    <% if paginator.next_page %>
      <a href="<%= paginator.next_page_path %>" class="article-pagination-older"><span aria-hidden="true">←</span> Older posts</a>
    <% end %>
    <% if paginator.previous_page %>
      <a href="<%= paginator.previous_page_path %>" class="article-pagination-newer">Newer posts <span aria-hidden="true">→</span></a>
    <% end %>
  </nav>
<% end %>
