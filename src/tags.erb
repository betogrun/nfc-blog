---
layout: default
title: "Tags"
description: "Tag cloud from all the posts"
permalink: /tags.*
sitemap: false
---
<% counts = collections.posts.resources.flat_map { it.data.tags || [] }.tally.sort.to_h %>

<div class="tags-page">
  <h1 class="tags-page-header">
    Tags
  </h1>

  <% counts.each do |slug, count| %>
    <% name = (site.data.tags[slug]&.name || slug).upcase %>
    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    <a class="tag-cloud" href="/tag/<%= slug %>/" title="See all posts by <%= name %> tag"
      style="font-size: <%= count * 15 + 120 %>%">
      <span><%= name %><small>(<%= count %>)</small></span>
    </a>
  <% end %>
</div>
