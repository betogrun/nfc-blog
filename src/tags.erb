<% topics = TopicIndex.topics %>

<div class="tags-page">
  <h1><%= t("tags.title") %></h1>
  <p class="tags-page-count"><%= t("tags.summary", topics: topics.size, posts: Locales.listed_posts.size) %></p>
  <%= render TopicIndex.new(heading: false, topics:) %>
</div>
