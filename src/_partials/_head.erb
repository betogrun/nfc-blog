<meta charset="utf-8">
<%# The tab title keeps the Jekyll order ("Site | Page"); seo-tag would render "Page | Site",
    so seo_metadata (plugins/builders/seo_metadata.rb) renders it with title: false. %>
<title><%= metadata.title %> | <%= resource.data.title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<%= seo_metadata %>
<%# Each version of the page, for search engines; English is the default. %>
<% if (alternates = Locales.alternates(resource)).any? %>
  <% alternates.each do |locale, path| %>
    <link rel="alternate" hreflang="<%= t("lang", locale:) %>" href="<%= absolute_url path %>">
  <% end %>
  <link rel="alternate" hreflang="x-default" href="<%= absolute_url alternates[Locales::DEFAULT] %>">
  <%= render LanguageRedirect.new %>
<% end %>
<link type="application/atom+xml" rel="alternate" href="<%= absolute_url Locales.path("/feed.xml") %>" title="<%= metadata.title %>">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="apple-touch-icon" href="/images/apple-touch-icon-dark.png">

<%# Apply a saved theme choice before first paint to avoid a flash of the other theme. %>
<script>
  if (localStorage.getItem("theme")) document.documentElement.dataset.theme = localStorage.getItem("theme")
</script>
<link rel="stylesheet" href="<%= asset_path :css %>">
<script src="<%= asset_path :js %>" defer></script>
