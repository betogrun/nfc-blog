---
layout: default
---
<% posts = Locales.listed_posts(data.locale).select { it.data.tags&.include?(data.tag_slug) } %>

<header class="tag-header">
  <h1><%= data.title %></h1>
  <% if posts.any? %>
    <p class="tag-count"><%= t("tag.count", count: posts.size) %></p>
  <% end %>
</header>
<% if posts.any? %>
  <ul class="article-list">
    <% posts.each do |post| %>
      <%= render ArticleListItem.new(post:) %>
    <% end %>
  </ul>
<% else %>
  <p class="article-empty"><%= t("tag.empty", name: data.title) %></p>
<% end %>
