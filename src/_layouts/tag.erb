---
layout: default
---
<% posts = collections.posts.resources.select { it.data.tags&.include?(data.tag_slug) } %>

<% if posts.any? %>
  <ul class="article-list">
    <% posts.each do |post| %>
      <li class="article-list-item scrollappear">
        <a href="<%= post.relative_url %>" title="<%= post.data.title %>">
          <h5><%= post.data.title %></h5>
        </a>
        <p><%= post.data.description %></p>
        <%= render ArticleMeta.new(post:) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="article-empty">There are no posts in <%= data.tag_slug %>.</p>
<% end %>
