---
layout: default
---
<% posts = collections.posts.resources.select { it.data.tags&.include?(data.tag_slug) } %>

<% if posts.any? %>
  <ul class="article-list">
    <% posts.each do |post| %>
      <li class="article-list-item">
        <a href="<%= post.relative_url %>"><h2><%= post.data.title %></h2></a>
        <p class="article-list-description"><%= post.data.description %></p>
        <%= render ArticleMeta.new(post:) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="article-empty">There are no posts in <%= data.tag_slug %>.</p>
<% end %>
