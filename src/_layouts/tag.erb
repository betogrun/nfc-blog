---
layout: default
---
<% posts = collections.posts.resources.select { it.data.tags&.include?(data.tag_slug) } %>

<header class="tag-header">
  <h1><%= data.title %></h1>
  <% if posts.any? %>
    <p class="tag-count"><%= posts.size %> <%= posts.one? ? "post" : "posts" %></p>
  <% end %>
</header>
<% if posts.any? %>
  <ul class="article-list">
    <% posts.each do |post| %>
      <%= render ArticleListItem.new(post:) %>
    <% end %>
  </ul>
<% else %>
  <p class="article-empty">There are no posts in <%= data.tag_slug %>.</p>
<% end %>
