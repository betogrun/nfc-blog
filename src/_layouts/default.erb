<!doctype html>
<html lang="<%= t("lang") %>" data-locale="<%= I18n.locale %>">
  <head>
    <%= render "head", metadata: site.metadata %>
  </head>
  <body>
    <%= render Navigation.new(metadata: site.metadata, tagline: data.tagline, alternates: Locales.alternates(resource)) %>
    <main class="page">
      <%= yield %>
    </main>
    <div class="page">
      <%= render "footer", metadata: site.metadata %>
    </div>
  </body>
</html>
