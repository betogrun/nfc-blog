---
layout: default
---
<article class="article">
  <header class="article-header">
    <%= render ArticleMeta.new(post: resource, tags: false) %>
    <h1><%= data.title %></h1>
    <% if data.description %>
      <p class="article-description"><%= data.description %></p>
    <% end %>
  </header>

  <div class="article-content">
    <%= OpeningPhrase.wrap(yield).html_safe %>
  </div>

  <p class="article-filed">
    <% tags = ArticleMeta.tags(resource) %>
    <% if tags.any? %>
      <%= t("post.filed_under") %> <% tags.each_with_index do |tag, index| %><%= ", " if index.positive? %><a href="<%= tag.href %>"><%= tag.name %></a><% end %>
    <% end %>
    <span class="article-share" hidden><span aria-hidden="true"> · </span><button type="button" data-share
        data-share-title="<%= data.title %>" data-share-url="<%= absolute_url resource.relative_url %>"
        data-share-copied="<%= t("post.link_copied") %>" data-share-failed="<%= t("post.copy_failed") %>"
        aria-live="polite"><%= t("post.share") %></button></span>
  </p>
</article>

<nav class="article-nav" aria-label="<%= t("post.more_posts") %>">
  <%# Posts are sorted newest first, so the next one in the same language is the older post. %>
  <% posts = Locales.posts(data.locale) %>
  <% if (older = posts[posts.index(resource) + 1]) %>
    <a href="<%= older.relative_url %>" class="article-nav-older"><span aria-hidden="true">←</span> <%= older.data.title %></a>
  <% end %>
  <a href="<%= Locales.path("/") %>" class="article-nav-contents"><%= t("post.contents") %></a>
</nav>

<% if site.metadata.disqus %>
  <div id="disqus_thread" class="article-comments"
    data-disqus-shortname="<%= site.metadata.disqus %>"
    data-disqus-identifier="<%= resource.relative_url %>"
    data-disqus-url="<%= absolute_url resource.relative_url %>"
    data-disqus-language="<%= t("lang").tr("-", "_") %>"></div>
  <noscript><%= t("post.enable_javascript") %></noscript>
<% end %>
