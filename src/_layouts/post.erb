---
layout: default
---
<article class="article">
  <header class="article-header">
    <%= render ArticleMeta.new(post: resource, tags: false) %>
    <h1><%= data.title %></h1>
    <% if data.description %>
      <p class="article-description"><%= data.description %></p>
    <% end %>
  </header>

  <div class="article-content">
    <%= OpeningPhrase.wrap(yield).html_safe %>
  </div>

  <p class="article-filed">
    <% tags = ArticleMeta.tags(resource) %>
    <% if tags.any? %>
      filed under <% tags.each_with_index do |tag, index| %><%= ", " if index.positive? %><a href="<%= tag.href %>"><%= tag.name %></a><% end %>
    <% end %>
    <span class="article-share" hidden><span aria-hidden="true"> · </span><button type="button" data-share
        data-share-title="<%= data.title %>" data-share-url="<%= absolute_url resource.relative_url %>"
        aria-live="polite">share</button></span>
  </p>
</article>

<nav class="article-nav" aria-label="More posts">
  <%# Posts are sorted newest first, so the next resource is the older post. %>
  <% if (older = resource.next_resource) %>
    <a href="<%= older.relative_url %>" class="article-nav-older"><span aria-hidden="true">←</span> <%= older.data.title %></a>
  <% end %>
  <a href="/" class="article-nav-contents">Contents</a>
</nav>

<% if site.metadata.disqus %>
  <div id="disqus_thread" class="article-comments"
    data-disqus-shortname="<%= site.metadata.disqus %>"
    data-disqus-identifier="<%= resource.relative_url %>"
    data-disqus-url="<%= absolute_url resource.relative_url %>"></div>
  <noscript>Please enable JavaScript to view the comments.</noscript>
<% end %>
