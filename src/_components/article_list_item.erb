<li class="article-list-item">
  <div class="article-list-heading">
    <a href="<%= @post.relative_url %>"><h2><%= @post.data.title %></h2></a>
    <span class="article-list-leader" aria-hidden="true"></span>
    <time datetime="<%= date %>"><%= date %></time>
  </div>
  <p class="article-list-description"><%= @post.data.description %></p>
  <%= render ArticleMeta.new(post: @post, date: false) %>
</li>
