<p class="article-meta">
  <time datetime="<%= date %>"><%= date %></time><span class="article-meta-divider" aria-hidden="true"> · </span><%= minutes %> min
  <% if tags.any? %>
    <span class="article-meta-divider" aria-hidden="true"> · </span><% tags.each_with_index do |tag, index| %><%= ", " if index.positive? %><a href="<%= tag.href %>"><%= tag.name %></a><% end %>
  <% end %>
</p>
