<p class="article-meta">
  <% if @show_date %>
    <time datetime="<%= date %>"><%= date %></time><span class="article-meta-divider" aria-hidden="true"> · </span>
  <% end %>
  <%= minutes %> min
  <% if tags.any? %>
    <span class="article-meta-divider" aria-hidden="true"> · </span><span class="article-meta-tags"><% tags.each_with_index do |tag, index| %><%= ", " if index.positive? %><a href="<%= tag.href %>"><%= tag.name %></a><% end %></span>
  <% end %>
</p>
