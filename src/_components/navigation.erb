<header class="site-header">
  <nav class="site-nav" aria-label="Site">
    <% site_links.each do |name, href| %>
      <a href="<%= href %>"><%= name %></a>
    <% end %>
  </nav>
  <a href="/" class="site-name"><%= @metadata.title %></a>
  <div class="site-preferences">
    <button type="button" class="theme-toggle" aria-label="Switch theme" data-theme-toggle>
      <%= render Icon.new("theme") %>
    </button>
  </div>
</header>
